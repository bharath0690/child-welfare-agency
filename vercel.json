{
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{cwa/**,skills/**,AGENTS.md}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
