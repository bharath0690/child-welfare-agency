# Copy to .env for local runs (python dev.py reads it). Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: send production traces and eval experiments to Braintrust (pip install -r requirements.txt)
BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT=binti-ai-prototype
# BRAINTRUST_LOG_CONTENT=false   # metadata only, no message text
# Optional: eval judges (helpfulness, politeness and empathy). Claude is used when ANTHROPIC_API_KEY is set
# (pip install -r evals/requirements.txt); otherwise DeepSeek with JUDGE_API_KEY or DEEPSEEK_API_KEY.
